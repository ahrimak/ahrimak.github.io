---
import { Image } from 'astro:assets';
import TagLink from '../components/TagLink.astro';
import { jpDate, type Post, postUrl, readMinutes } from '../lib/posts';
import Base from './Base.astro';

interface Props {
	post: Post;
	newer?: Post;
	older?: Post;
}

const { post, newer, older } = Astro.props;
const { title, description, pubDate, updatedDate, heroImage, tags } = post.data;
const pagerLink = 'max-w-[48%] no-underline hover:underline';
const pagerLabel = 'block font-mono text-[11px] tracking-[.1em] text-muted';
// Markdown から生成される本文。要素ごとの見た目は Typography の修飾子で指定する
const proseClass = [
	'prose prose-site max-w-none leading-[1.9] prose-a:font-normal prose-a:no-underline',
	'prose-headings:mt-[2em] prose-headings:mb-[0.6em] prose-headings:font-display prose-headings:font-bold prose-headings:leading-normal',
	'prose-h2:text-2xl prose-h3:text-xl prose-h4:text-[17px]',
	'prose-blockquote:border-l-2 prose-blockquote:pl-[18px] prose-blockquote:font-display prose-blockquote:font-normal prose-blockquote:not-italic',
	'[&_blockquote_p]:before:content-none [&_blockquote_p]:after:content-none',
	'prose-code:rounded-xs prose-code:bg-accent-soft prose-code:px-1.5 prose-code:py-0.5 prose-code:text-[0.88em] prose-code:font-normal prose-code:before:content-none prose-code:after:content-none',
	'[&_pre_code]:bg-transparent [&_pre_code]:p-0 [&_pre_code]:text-[length:inherit]',
	'prose-pre:rounded-md prose-pre:p-5 prose-pre:text-sm/relaxed',
	'prose-hr:my-10 prose-img:rounded-md',
	'prose-table:text-sm prose-th:px-2 prose-th:py-1 prose-td:px-2 prose-td:py-1',
].join(' ');
---

<Base title={title} description={description} image={heroImage}>
	<article class="max-w-[38em]">
		<a href="/" class="mb-7 inline-block text-[13px] no-underline hover:underline">← 記事一覧へ</a>
		<header class="mb-7 flex flex-col gap-3 border-b border-line pb-6">
			<p class="m-0 font-mono text-[13px] tabular-nums text-muted">
				<time datetime={pubDate.toISOString()}>{jpDate(pubDate)}</time>
				· 約{readMinutes(post)}分
				{
					updatedDate && (
						<>
							· 更新 <time datetime={updatedDate.toISOString()}>{jpDate(updatedDate)}</time>
						</>
					)
				}
			</p>
			<h1 class="m-0 font-display text-[clamp(26px,4.4vw,34px)]/[1.45] font-bold text-balance">
				{title}
			</h1>
			{
				tags.length > 0 && (
					<div class="flex flex-wrap gap-1.5">
						{tags.map((tag) => (
							<TagLink tag={tag} size="sm" />
						))}
					</div>
				)
			}
		</header>
		{heroImage && <Image width={760} height={380} src={heroImage} alt="" class="mb-7 rounded-md" />}
		<div class={proseClass}>
			<slot />
		</div>
		<nav
			aria-label="前後の記事"
			class="mt-12 flex justify-between gap-4 border-t border-line pt-5 text-sm"
		>
			{
				older ? (
					<a href={postUrl(older)} class={pagerLink}>
						<small class={pagerLabel}>← OLDER</small>
						{older.data.title}
					</a>
				) : (
					<span />
				)
			}
			{
				newer ? (
					<a href={postUrl(newer)} class:list={[pagerLink, 'text-right']}>
						<small class={pagerLabel}>NEWER →</small>
						{newer.data.title}
					</a>
				) : (
					<span />
				)
			}
		</nav>
	</article>
</Base>
