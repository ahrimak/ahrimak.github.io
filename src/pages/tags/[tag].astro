---
import PostList from '../../components/PostList.astro';
import Base from '../../layouts/Base.astro';
import { allTags, getPosts } from '../../lib/posts';

export async function getStaticPaths() {
	const posts = await getPosts();
	return allTags(posts).map((tag) => ({
		params: { tag },
		props: { tag, posts: posts.filter((p) => p.data.tags.includes(tag)) },
	}));
}

const { tag, posts } = Astro.props;
---

<Base title={`タグ「${tag}」`} currentTag={tag}>
	<PostList posts={posts} label={`タグ「${tag}」`} currentTag={tag} />
</Base>
