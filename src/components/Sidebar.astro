---
import Icon from '../assets/ahrimak-icon.svg';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { allTags, archiveMonths, getPosts, monthLabel, monthUrl } from '../lib/posts';
import TagLink from './TagLink.astro';

interface Props {
	currentTag?: string;
	currentMonth?: string;
}

const { currentTag, currentMonth } = Astro.props;
const posts = await getPosts();
const months = archiveMonths(posts);
const tags = allTags(posts);
const heading = 'mb-2.5 border-b border-line pb-1.5 font-mono text-[11px] uppercase tracking-[.14em] text-muted';
---

<aside class="flex flex-col gap-5 md:gap-9">
	<div class="flex flex-col gap-2">
		<div class="flex items-center justify-between gap-3">
			<p class="m-0 font-display text-[26px] font-bold leading-[1.3] tracking-[.06em] md:text-[30px]">
				<a href="/" class="inline-flex items-center gap-3 text-ink no-underline">
					<Icon width={36} height={36} aria-hidden="true" class="shrink-0" />
					{SITE_TITLE}
				</a>
			</p>
			<button
				type="button"
				id="theme-toggle"
				aria-label="ダークモードに切り替える"
				class="grid size-9 shrink-0 cursor-pointer place-items-center rounded-md border border-line bg-surface text-muted hover:border-accent hover:text-accent"
			>
				<!-- ライト表示中は月 (押すとダーク)、ダーク表示中は太陽 (押すとライト) を出す -->
				<svg
					class="theme-icon-moon size-[18px]"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5Z"></path>
				</svg>
				<svg
					class="theme-icon-sun size-[18px]"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					aria-hidden="true"
				>
					<circle cx="12" cy="12" r="4"></circle>
					<path
						d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
					></path>
				</svg>
			</button>
		</div>
		<p class="m-0 text-[13px]/[1.7] text-muted">{SITE_DESCRIPTION}</p>
	</div>

	<form action="/search/" role="search">
		<label for="sidebar-search" class="sr-only">記事を検索</label>
		<input
			type="search"
			id="sidebar-search"
			name="q"
			placeholder="記事を検索"
			class="w-full rounded-md border border-line bg-surface px-3 py-1.5 text-sm text-ink placeholder:text-muted focus:border-accent"
		/>
	</form>

	{
		months.length > 0 && (
			<nav aria-label="アーカイブ">
				<h2 class={heading}>Archive</h2>
				<ul class="flex flex-wrap gap-x-4 gap-y-1 text-sm md:flex-col md:gap-0.5">
					{months.map(([key, n]) => {
						const active = key === currentMonth;
						return (
							<li>
								<a
									href={active ? '/' : monthUrl(key)}
									aria-current={active ? 'page' : undefined}
									class:list={[
										'flex items-baseline justify-between gap-1.5 py-0.5 no-underline hover:text-accent',
										active ? 'font-bold text-accent' : 'text-ink',
									]}
								>
									{monthLabel(key)}
									<span class="font-mono text-xs font-normal tabular-nums text-muted">{n}</span>
								</a>
							</li>
						);
					})}
				</ul>
			</nav>
		)
	}

	{
		tags.length > 0 && (
			<nav aria-label="タグ">
				<h2 class={heading}>Tags</h2>
				<div class="flex flex-wrap gap-1.5">
					{tags.map((tag) => (
						<TagLink tag={tag} current={currentTag} />
					))}
				</div>
			</nav>
		)
	}
</aside>

<script>
	const button = document.getElementById('theme-toggle')!;
	const root = document.documentElement;
	const systemDark = matchMedia('(prefers-color-scheme: dark)');
	const isDark = () => (root.dataset.theme ?? (systemDark.matches ? 'dark' : 'light')) === 'dark';
	const updateLabel = () =>
		button.setAttribute('aria-label', isDark() ? 'ライトモードに切り替える' : 'ダークモードに切り替える');

	button.addEventListener('click', () => {
		const theme = isDark() ? 'light' : 'dark';
		root.dataset.theme = theme;
		try {
			localStorage.setItem('theme', theme);
		} catch {}
		updateLabel();
	});
	systemDark.addEventListener('change', updateLabel);
	updateLabel();
</script>
